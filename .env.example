# SAP B1 - Credential configuration (Layer 2)
# COPY THIS FILE TO .env FOR REAL-SERVER TESTING

# Service Layer
B1SL_BASE_URL=https://localhost:50000/b1s/v2
B1SL_COMPANY_DB=SBODemoMX
B1SL_USERNAME=manager
B1SL_PASSWORD=sap
# TLS verification. Keep it at 1. If your Service Layer uses a self-signed
# certificate, install its CA in the system trust store instead of setting
# this to 0 — disabling exposes credentials and the session cookie to MITM.
B1SL_SSL_VERIFY=1

# SDK runtime environment
# Valid values: dev | test | prod
# - dev  → human-readable text logs (default)
# - test → same as dev, signals test isolation
# - prod → structured JSON logs (for ELK, Datadog, etc.)
# Note: formats apply only if you opt in via logging_utils.setup_logging();
# the SDK never installs log handlers by itself.
B1SL_ENV=dev

# Integration test execution control
# 1 = Run real integration tests (tests/integration/)
# 0 = Mocks only (tests/unit/), skip tests marked @pytest.mark.integration
SAP_B1_INTEGRATION=0

# --- Advanced Tuning (Optional) ---
# B1SL_REUSE_TOKEN=1
# Fallback session lifetime (seconds), used only when SAP's Login response
# omits SessionTimeout.
# B1SL_TOKEN_TIMEOUT=900
# B1SL_ETAG_CACHE_SIZE=256
# B1SL_CONNECT_TIMEOUT=10
# B1SL_READ_TIMEOUT=60

# --- Safety & Debugging ---
# Set to 1 to intercept all write requests (POST, PATCH, DELETE) without hitting SAP.
B1SL_DRY_RUN=0
